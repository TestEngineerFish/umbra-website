---
// 功能总览：七个模块一张网格，点进去是各自的子页。
import Base from '../../layouts/Base.astro';
import { zh as t } from '../../i18n/zh';
import { shotUrl } from '../../lib/shots';

const F = t.features;
---
<Base title={F.title} description={F.lead} current="/features/">
  <div class="wrap page-head">
    <div class="eyebrow">{t.brand}</div>
    <h1>{F.title}</h1>
    <p class="lead">{F.lead}</p>
  </div>
  <div class="wrap">
    <ul class="grid">
      {F.items.map((f) => {
        const src = shotUrl(f.shot);
        return (
          <li>
            <a href={`/features/${f.slug}/`} class="card">
              <div class="thumb">{src ? <img src={src} alt="" loading="lazy" decoding="async" width="1600" height="1000" /> : <span />}</div>
              <div class="txt">
                <div class="eyebrow">{f.eyebrow}</div>
                <h2>{f.name}</h2>
                <p>{f.short}</p>
                <span class="link-more">{F.moreLabel} →</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .grid { list-style: none; margin: 0 0 10vh; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .card { height: 100%; display: flex; flex-direction: column; text-decoration: none; border-radius: 16px; overflow: hidden; background: var(--card); border: 1px solid var(--border); transition: border-color .15s, transform .25s var(--ease-out); }
  .card:hover { border-color: var(--orange); transform: translateY(-2px); }
  .thumb { aspect-ratio: 16 / 9; background: radial-gradient(110% 90% at 85% 0%, var(--orange-soft), transparent 60%), var(--rail); border-bottom: 1px solid var(--border-soft); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .txt { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .txt h2 { font-size: 22px; }
  .txt p { color: var(--muted); font-size: 15px; flex: 1; }
  .eyebrow { font-size: 11px; }
</style>
