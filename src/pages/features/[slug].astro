---
// 功能子页（苹果式）：大标题 → 左边章节逐段滚、右边截图钉住；当前章节高亮。手机上截图在上、章节在下。
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { zh as t } from '../../i18n/zh';

export function getStaticPaths() {
  return t.features.items.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}

const { f } = Astro.props;
const related = f.related.map((s) => t.features.items.find((x) => x.slug === s)).filter((x) => !!x);
---
<Base title={f.name} description={f.short} current="/features/">
  <section class="wrap page-head">
    <a class="crumb" href="/features/">← {t.features.title}</a>
    <div class="eyebrow">{f.eyebrow}</div>
    <h1 class="pre-line">{f.title}</h1>
    <p class="lead">{f.lead}</p>
  </section>

  <section class="wrap story">
    <ol class="chapters">
      {f.chapters.map((c, i) => (
        <li class="chap" data-i={i}>
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
        </li>
      ))}
    </ol>
    <div class="stage">
      <div class:list={['pin', { duo: f.phone }]}>
        <Shot name={f.shot} alt={`${f.name} 电脑端界面`} eager />
        {f.phone && <div class="ph-over"><Shot name={f.phone} alt={`${f.name} iPhone 界面`} phone /></div>}
      </div>
    </div>
  </section>

  <section class="wrap specs">
    <ul>{f.specs.map((s) => <li>{s}</li>)}</ul>
  </section>

  {related.length > 0 && (
    <section class="wrap related">
      <h2>{t.features.related}</h2>
      <div class="rel">
        {related.map((r) => (
          <a href={`/features/${r!.slug}/`}><b>{r!.name}</b><span>{r!.short}</span></a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // 章节高亮：哪一段过了视口中线就亮哪段。没有 IntersectionObserver 时全部保持常亮（默认态就是可读的）。
  const chaps = [...document.querySelectorAll<HTMLElement>('.chap')];
  if ('IntersectionObserver' in window && chaps.length) {
    document.documentElement.classList.add('js-chapters');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) chaps.forEach((c) => c.classList.toggle('on', c === e.target));
    }, { rootMargin: '-45% 0px -45% 0px' });
    chaps.forEach((c) => io.observe(c));
    chaps[0].classList.add('on');
  }
</script>

<style>
  .crumb { font-size: 14px; color: var(--muted); text-decoration: none; }
  .crumb:hover { color: var(--text); }
  .story { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .chapters { list-style: none; margin: 0; padding: 4vh 0 20vh; display: flex; flex-direction: column; gap: 26vh; }
  .chap { display: flex; flex-direction: column; gap: 10px; transition: opacity .35s var(--ease-out); }
  :global(.js-chapters) .chap { opacity: .32; }
  :global(.js-chapters) .chap.on { opacity: 1; }
  .no { font-family: var(--font-mono); font-size: 12px; color: var(--orange-text); }
  .chap h2 { font-size: clamp(24px, 2.6vw, 32px); }
  .chap p { color: var(--muted); font-size: 16.5px; line-height: 1.8; }
  .stage { position: relative; height: 100%; }
  .pin { position: sticky; top: calc(var(--header-h) + 8vh); }
  .duo { padding-bottom: 12%; }
  .ph-over { position: absolute; right: -2%; bottom: 0; width: 26%; min-width: 120px; }

  .specs { padding-block: 4vh 8vh; }
  .specs ul { list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px 28px; }
  .specs li { font-size: 14.5px; color: var(--muted); padding-left: 16px; position: relative; }
  .specs li::before { content: ''; position: absolute; left: 0; top: .68em; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }

  .related { padding-bottom: 12vh; display: flex; flex-direction: column; gap: 16px; }
  .related h2 { font-size: 20px; }
  .rel { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .rel a { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; border-radius: 14px; border: 1px solid var(--border); background: var(--card); text-decoration: none; }
  .rel a:hover { border-color: var(--orange); }
  .rel span { font-size: 14px; color: var(--muted); }

  @media (max-width: 860px) {
    .story { grid-template-columns: minmax(0, 1fr); }
    .stage { order: -1; height: auto; margin-bottom: 8px; }
    .pin { position: relative; top: auto; }
    .ph-over { right: 0; width: 30%; }
    .chapters { gap: 40px; padding: 2vh 0 6vh; }
    :global(.js-chapters) .chap { opacity: 1; }
  }
</style>
