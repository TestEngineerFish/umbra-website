---
// 首页：从星空落到枝头（方案 ../doc/官网首页-星空到枝头-方案.md）。七段内容走正常文档流；背后一张钉住的 canvas 按滚动画天空（scripts/sky/scene.ts）。
// 第一帧就是完整的：canvas 没跑起来时，<html> 背景和 .backdrop 的 CSS 渐变先把夜空铺出来，文字一直可读。
// 每段的浅深字（data-ink）取自 LAYERS：天亮以后的两层用深字。
import Base from '../layouts/Base.astro';
import { zh as t } from '../i18n/zh';
import { LAYERS } from '../scripts/sky/layers';

const S = t.home.sections;
const ink = (id: string) => LAYERS.find((l) => l.id === id)?.ink ?? 'light';
const [first, dive, ...rest] = S;
const last = S[S.length - 1];
const middle = rest.slice(0, -1);
---
<Base sky>
  <div class="backdrop" aria-hidden="true"></div>
  <canvas id="sky-canvas" aria-hidden="true"></canvas>

  <aside class="gauge" aria-label={t.home.gaugeLabel}>
    <div class="read" aria-live="off">
      <div class="z" id="zone">{S[0].layer}</div>
    </div>
    <ol class="ruler">
      {S.map((s, i) => (
        <li><a class="tick" href={`#${s.id}`} aria-label={`${t.home.gaugeJump}${s.zone}`} aria-current={i === 0 ? 'true' : undefined}>{s.zone}</a></li>
      ))}
    </ol>
  </aside>

  <div class="dive" data-names={JSON.stringify(S.map((s) => s.layer))}>
    <section class="sec hero" id={first.id} data-ink={ink(first.id)}>
      <div class="inner copy">
        <div class="eyebrow">{first.eyebrow}</div>
        <h1 class="pre-line">{first.title}</h1>
        <p class="body hero-lead">{first.body}</p>
        <div class="cta">
          {first.cta?.map((c) => <a class:list={['btn', c.primary ? 'btn-primary glow' : 'btn-glass']} href={c.href}>{c.label}</a>)}
        </div>
      </div>
    </section>

    <section class="sec split" id={dive.id} data-ink={ink(dive.id)}>
      <div class="inner">
        <div class="say"><small>{dive.say?.who}</small>{dive.say?.text}</div>
      </div>
      <div class="inner copy">
        <div class="eyebrow">{dive.eyebrow}</div>
        <h2 class="pre-line">{dive.title}</h2>
        <ol class="steps">
          {dive.steps?.map((s) => <li><b>{s.at}</b><span>{s.text}</span></li>)}
        </ol>
      </div>
    </section>

    {middle.map((s) => (
      <section class="sec" id={s.id} data-ink={ink(s.id)}>
        <div class="inner copy">
          <div class="eyebrow">{s.eyebrow}</div>
          <h2>{s.title}</h2>
          <p class="body">{s.body}</p>
          {s.chips && <ul class="chips">{s.chips.map((c) => <li>{c}</li>)}</ul>}
          {s.more && <a class="more" href={s.more.href}>{s.more.label} →</a>}
        </div>
      </section>
    ))}

    <section class="sec floor" id={last.id} data-ink={ink(last.id)}>
      <div class="inner copy wide">
        <div class="eyebrow">{last.eyebrow}</div>
        <h2 class="pre-line">{last.title}</h2>
        <p class="body">{last.body}</p>
        <div class="dl">
          {t.download.items.map((d) => (
            <a href="/download/" class:list={[{ off: d.key === 'android' }]}><b>{d.name}</b><em>{d.key === 'android' ? t.download.soon : d.req}</em></a>
          ))}
        </div>
        {last.more && <a class="more" href={last.more.href}>{last.more.label} →</a>}
      </div>
    </section>
  </div>
</Base>

<script>
  import { startSky } from '../scripts/sky/scene';
  import type { Tier } from '../scripts/sky/tier';

  const host = document.querySelector<HTMLElement>('.dive')!;
  const canvas = document.getElementById('sky-canvas') as HTMLCanvasElement;
  // ?tier=mid 强制某一档、?perf 记录每帧耗时：只给 snap / perf 脚本用
  const q = new URLSearchParams(location.search);
  const forced = q.get('tier');
  startSky({
    canvas,
    sections: [...host.querySelectorAll<HTMLElement>('.sec')],
    readout: {
      zone: document.getElementById('zone')!,
      names: JSON.parse(host.dataset.names!),
      ticks: [...document.querySelectorAll<HTMLElement>('.tick')],
    },
    forceTier: forced && ['high', 'mid', 'low', 'static'].includes(forced) ? (forced as Tier) : undefined,
    perf: q.has('perf'),
  });
  canvas.classList.add('on');
</script>

<style>
  /* canvas 起来之前的兜底画面：深夜星空的天色，和 canvas 第一帧同色（LAYERS[0].sky） */
  .backdrop { position: fixed; inset: 0; z-index: 0; background: linear-gradient(#04060e 0%, #0a0f25 55%, #141a3a 100%); }
  #sky-canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; opacity: 0; transition: opacity .4s; }
  #sky-canvas.on { opacity: 1; }
  .dive { position: relative; z-index: 1; --gauge-w: 150px; }

  .sec { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 16vh; padding-left: var(--gutter); padding-right: var(--gutter-r); }
  .inner { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-right: var(--gauge-w); }
  .copy { display: flex; flex-direction: column; gap: 16px; text-shadow: 0 1px 14px rgba(0, 0, 0, .45); }
  .copy > * { max-width: 31rem; }
  .copy.wide > * { max-width: 42rem; }
  .eyebrow { color: #F0A878; }
  h1, h2 { color: #fff; }
  .body { font-size: clamp(15.5px, 1.35vw, 17.5px); line-height: 1.75; color: rgba(237, 234, 227, .7); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 4px 0 0; list-style: none; }
  .chips li { font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(240, 168, 120, .35); background: rgba(21, 17, 14, .28); text-shadow: none; }
  .more { color: #F0A878; text-decoration: none; font-weight: 600; font-size: 15px; align-self: flex-start; }
  .more:hover { text-decoration: underline; }

  .hero { justify-content: flex-start; padding-top: calc(var(--header-h) + 15vh + env(safe-area-inset-top, 0px)); }
  .hero .copy > * { max-width: 37rem; }
  .hero-lead { color: rgba(255, 240, 228, .88); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; text-shadow: none; }
  .glow { box-shadow: 0 6px 24px rgba(232, 89, 12, .45); }
  .btn-glass { color: #fff; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .36); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .btn-glass:hover { background: rgba(255, 255, 255, .2); }

  .split { justify-content: space-between; padding-block: 14vh 18vh; }
  .say { max-width: 26rem; background: #EAF1F7; color: #1F2320; border-radius: 16px 16px 16px 4px; padding: 13px 16px; font-size: 16px; line-height: 1.6; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); }
  .say small { display: block; font-size: 12px; color: #656B65; margin-bottom: 3px; }
  .steps { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-family: var(--font-mono); font-size: 13.5px; color: #EDEAE3; }
  .steps li { display: flex; gap: 12px; align-items: baseline; }
  .steps b { font-weight: 500; color: #F0A878; min-width: 5.2em; flex: none; }

  .floor { justify-content: flex-end; padding-bottom: 8vh; min-height: 115svh; }
  .dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 6px; }
  .dl a { display: flex; flex-direction: column; gap: 2px; padding: 13px 15px; border-radius: 12px; text-decoration: none; color: #EDEAE3; background: rgba(237, 234, 227, .07); border: 1px solid rgba(240, 168, 120, .25); text-shadow: none; transition: background-color .15s, border-color .15s; }
  .dl a:hover { background: rgba(232, 89, 12, .18); border-color: #E8590C; }
  .dl a.off { opacity: .55; }
  .dl b { font-size: 15px; font-weight: 600; }
  .dl em { font-style: normal; font-size: 12.5px; color: rgba(237, 234, 227, .62); }

  /* 天亮以后的层：深字（色值待设计侧裁） */
  [data-ink='dark'] .copy { text-shadow: 0 1px 16px rgba(255, 255, 255, .45); }
  [data-ink='dark'] h2 { color: #16202c; }
  [data-ink='dark'] .eyebrow, [data-ink='dark'] .more { color: #a3420c; }
  [data-ink='dark'] .body { color: rgba(22, 32, 44, .78); }
  [data-ink='dark'] .chips li { border-color: rgba(22, 32, 44, .2); background: rgba(255, 255, 255, .35); color: #16202c; }
  [data-ink='dark'] .dl a { color: #16202c; background: rgba(255, 255, 255, .45); border-color: rgba(22, 32, 44, .14); }
  [data-ink='dark'] .dl a:hover { background: rgba(255, 255, 255, .7); border-color: #E8590C; }
  [data-ink='dark'] .dl em { color: rgba(22, 32, 44, .62); }

  /* 刻度尺（本页目录） */
  .gauge { position: fixed; z-index: 30; top: 50%; transform: translateY(-50%); right: max(18px, env(safe-area-inset-right, 0px)); width: 124px; display: flex; flex-direction: column; align-items: flex-end; gap: 14px; font-family: var(--font-mono); }
  .read { text-align: right; text-shadow: 0 1px 10px rgba(0, 0, 0, .5); background: rgba(21, 17, 14, .32); padding: 6px 10px; border-radius: 10px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .read .z { font-family: var(--font-sans); font-size: 13px; color: #F0A878; }
  .ruler { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: flex-end; }
  .ruler::before { content: ''; position: absolute; right: 3px; top: 10px; bottom: 10px; width: 1px; background: rgba(255, 255, 255, .28); }
  .tick { display: flex; align-items: center; gap: 9px; height: 30px; font-size: 11px; color: rgba(255, 255, 255, .55); text-decoration: none; font-variant-numeric: tabular-nums; }
  .tick::after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, .35); }
  .tick:hover, .tick[aria-current] { color: #fff; }
  .tick[aria-current]::after { background: #E8590C; box-shadow: 0 0 0 3px rgba(232, 89, 12, .3); }
  :global(html[data-ink='dark']) .read { background: rgba(255, 255, 255, .45); text-shadow: none; }
  :global(html[data-ink='dark']) .read .z { color: #a3420c; }
  :global(html[data-ink='dark']) .ruler::before { background: rgba(22, 32, 44, .25); }
  :global(html[data-ink='dark']) .tick { color: rgba(22, 32, 44, .55); }
  :global(html[data-ink='dark']) .tick:hover, :global(html[data-ink='dark']) .tick[aria-current] { color: #16202c; }
  :global(html[data-ink='dark']) .tick::after { background: rgba(22, 32, 44, .3); }

  @media (max-width: 760px) {
    .dive { --gauge-w: 0px; }
    .gauge { top: calc(var(--header-h) + 6px + env(safe-area-inset-top, 0px)); transform: none; width: auto; }
    .ruler { display: none; }
    :global(html:not([data-ink='dark'])) .read { background: rgba(21, 17, 14, .45); padding: 6px 10px; border-radius: 10px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .sec { padding-block: 13vh; }
  }
</style>

<style is:global>
  html.sky { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html.sky { scroll-behavior: auto; } }
</style>
