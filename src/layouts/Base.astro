---
// 全站外壳：head（标题、描述、OG、canonical）+ 顶栏 + 正文 + 页脚。
// ocean=true 是首页：深色海洋世界、不跟明暗主题、顶栏透明。
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { zh as t } from '../i18n/zh';

interface Props {
  title?: string;
  description?: string;
  ocean?: boolean;
  current?: string;
}
const { title, description = t.site.description, ocean = false, current = '' } = Astro.props;
const fullTitle = title ? `${title} · ${t.brand}` : t.site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const variant = ocean ? 'ocean' : 'page';
---
<!doctype html>
<html lang={t.lang} class:list={{ ocean }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={ocean ? '#24182f' : '#F6F5F2'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="format-detection" content="telephone=no" />
  </head>
  <body class:list={[variant]}>
    <a class="skip" href="#main">{t.site.skip}</a>
    <Header variant={variant} current={current} />
    <main id="main"><slot /></main>
    <Footer variant={variant} />
  </body>
</html>

<style is:global>
  /* 首页：单一的深色海洋世界，显式给出颜色，不随明暗主题切换 */
  html.ocean { color-scheme: dark; background: #15110E; }
  body.ocean { background: #15110E; color: #EDEAE3; }
</style>
